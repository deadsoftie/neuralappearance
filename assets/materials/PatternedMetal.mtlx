<?xml version="1.0"?>
<materialx version="1.38">
  <surfacematerial name="mtlxsurfacematerial" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="mtlxsurface" value="" />
    <input name="displacementshader" type="displacementshader" value="" />
  </surfacematerial>

  <surface name="mtlxsurface" type="surfaceshader">
    <input name="bsdf" type="BSDF" nodename="mix_bsdf" value="" />
    <input name="edf" type="EDF" value="" />
    <input name="opacity" type="float" value="1" />
  </surface>

  <dielectric_bsdf name="dielectric_bsdf" type="BSDF">
    <input name="roughness" type="vector2" nodename="square_roughness" />
    <input name="ior" type="float" value="1.3" />
    <input name="distribution" type="string" value="ggx" />
    <input name="scatter_mode" type="string" value="R" />
    <input name="normal" type="vector3" nodename="normalmap" />
  </dielectric_bsdf>

  <oren_nayar_diffuse_bsdf name="diffuse_bsdf" type="BSDF">
    <input name="color" type="color3" nodename="basecolor_gamma" />
    <input name="roughness" type="float" value="0" />
    <input name="normal" type="vector3" nodename="normalmap" />
  </oren_nayar_diffuse_bsdf>

  <layer name="dielectric_diffuse_bsdf" type="BSDF">
    <input name="top" type="BSDF" nodename="dielectric_bsdf" value="" />
    <input name="base" type="BSDF" nodename="diffuse_bsdf" value="" />
  </layer>

  <conductor_bsdf name="conductor_bsdf" type="BSDF">
    <input name="ior" type="color3" nodename="artistic_ior" output="ior" />
    <input name="extinction" type="color3" nodename="artistic_ior" output="extinction" />
    <input name="roughness" type="vector2" nodename="square_roughness" />
    <input name="distribution" type="string" value="ggx" />
    <input name="normal" type="vector3" nodename="normalmap" />
  </conductor_bsdf>

  <mix name="mix_bsdf" type="BSDF">
    <input name="fg" type="BSDF" nodename="conductor_bsdf" />
    <input name="bg" type="BSDF" nodename="dielectric_diffuse_bsdf" />
    <input name="mix" type="float" nodename="metallic" />
  </mix>

  <tiledimage name="basecolor" type="color3">
    <input name="file" type="filename" value="PatternedMetal_basecolor.png" />
    <input name="uvtiling" type="vector2" nodename="uv_scale" />
  </tiledimage>
  <power name="basecolor_gamma" type="vector3">
    <input name="in1" type="vector3" nodename="basecolor" />
    <input name="in2" type="vector3" value="2.2, 2.2, 2.2" />
  </power>
  <artistic_ior name="artistic_ior" type="multioutput">
    <input name="reflectivity" type="color3" nodename="basecolor_gamma" />
    <input name="edge_color" type="color3" value="1.0, 1.0, 1.0" />
  </artistic_ior>

  <tiledimage name="roughness" type="float">
    <input name="file" type="filename" value="PatternedMetal_roughness.png" />
    <input name="uvtiling" type="vector2" nodename="uv_scale" />
  </tiledimage>
  <power name="square_roughness" type="float">
    <input name="in1" type="float" nodename="roughness" value="0" />
    <input name="in2" type="float" value="2" />
  </power>

  <tiledimage name="metallic" type="float">
    <input name="file" type="filename" value="PatternedMetal_metallic.png" />
    <input name="uvtiling" type="vector2" nodename="uv_scale" />
  </tiledimage>

  <tiledimage name="normal" type="vector3">
    <input name="file" type="filename" value="PatternedMetal_normal.png" />
    <input name="uvtiling" type="vector2" nodename="uv_scale" />
  </tiledimage>
  <normalmap name="normalmap" type="vector3">
    <input name="in" type="vector3" nodename="normal" />
  </normalmap>

  <constant name="uv_scale" type="vector2">
    <input name="value" type="vector2" value="1.0, -1.0" />
  </constant>
</materialx>
