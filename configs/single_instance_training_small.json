// Figure 1(c): single-instance baseline with an undersized 2x16 decoder.
// Different model seeds expose substantial variance in the learned material quality.
{
    "base_config": "default.json",
    "training": {
        "num_iterations": {
            "aux": 0
        },
        "instance_schedule": [1]
    },
    "model": {
        "seed": 0, // Change to compare outcomes across model initializations.
        "decoder": {
            "hidden_layers": [16, 16]
        }
    },
    "data_generation": {
        "seed": 0,
        "batch_size_schedule": ["64k"],
        "share_data_between_instances": true
    },
    "checkpoints": {
        "period": -1,
        "phases": ["Sampler"]
    }
}
