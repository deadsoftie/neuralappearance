// Figure 1(b): single-instance baseline with an overparameterized 4x128 decoder.
// Excess capacity makes outcomes consistently good across different model seeds.
{
    "base_config": "default.json",
    "training": {
        "num_iterations": {
            "aux": 0
        },
        "instance_schedule": [1]
    },
    "model": {
        "seed": 0, // Change to compare outcomes across model initializations.
        "decoder": {
            "hidden_layers": [128, 128, 128, 128]
        }
    },
    "data_generation": {
        "seed": 0,
        "batch_size_schedule": ["64k"],
        "share_data_between_instances": true
    },
    "checkpoints": {
        "period": -1,
        "phases": ["Sampler"]
    }
}
