{
    // rtcnam pilot (rtcnam/PLAN.md): pigmented_smooth_leather, NTC LatentShape
    // {gridSizeScale 6, numFeatures 8} == ntc-cli's 1.11 bpp preset.
    // Identical to configs/project3_pigmented_smooth_leather.json except
    // model.latents (ntc_grid instead of dense) and bsdf_finetuning (the
    // post-warmstart joint fine-tune phase needs real iterations here).
    "reference_materials": [
        {
            "type": "mdl",
            "path": "vMaterials_2/Leather/Pigmented_Smooth_Leather.mdl",
            "material": "Pigmented_Smooth_Leather"
        }
    ],

    "training": {
        "num_iterations": {
            "bsdf": 100000,
            "bsdf_finetuning": 100000,
            "sampler": 50000,
            "aux": 50000
        },
        "deterministic": true,
        "optimizer": {
            "learning_rate": 0.001,
            "cosine_annealing_scale": 0.01,
            "gradient_scale": 128.0,
            "hyperparams": {
                "beta1": 0.9,
                "beta2": 0.999,
                "epsilon": 1e-07,
                "l2_regularization": 0.0,
                "ignore_invalid_gradients": true
            }
        },
        "instance_schedule": [64, 16, 4, 1],
        "loss_function": {
            "type": "L1WithPowerLog",
            "power": 3.0,
            "epsilon": 1e-4
        },
        // rtcnam coverage penalty (train.slang eval_diropt_model_and_loss,
        // rtcnam/NTC_LATENT_TEXTURE_NOTES.md): during bsdf_finetuning,
        // penalizes BsdfDecoder luminance above `cap` at an extra random
        // uniform-hemisphere (wi, wo) sample per iteration, to keep it from
        // developing out-of-distribution spikes that indirect path-traced
        // bounces (sampled via the trained Sampler, not this training
        // distribution) can land on and blow up multiplicatively.
        // Tuning history on carpaint_metallic (not monotonic -- see below):
        //   weight=0.01,  cap=50 -> render max 1.1e37, 51% of pixels >10x ref
        //   weight=1.0,   cap=10 -> render max 2.6e27, 26%
        //   weight=100,   cap=5  -> render max 9.4e12, 13%  <- best found
        //   weight=10000, cap=5  -> render max 5.6e27, 51%  (regressed!)
        // Not a dial to max out: one regularizer sample/iteration is a
        // sparse signal over a 4D (wi,wo) domain, and too strong a pull
        // toward wherever THAT iteration's one sample lands can make
        // training chase it around ("whack-a-mole") rather than settle
        // into a globally smooth decoder, while the main BSDF loss stays
        // perfectly stable throughout (~0.18-0.20) regardless of weight --
        // this is real non-convergence of the regularizer's own objective,
        // not training instability. weight=100/cap=5 is the best of these
        // four; still not fully sane (positive PSNR), a real but partial
        // mitigation. cap=5 matches this material's actual peak BSDF value
        // -- the tightest physically-defensible choice, not loosened for
        // headroom.
        // DISABLED pending re-evaluation. This penalty was targeting a
        // symptom (high decoder luminance at off-manifold angles). The
        // actual cause was found to be latent saturation from the
        // `normalize_latent_code` squash in ntc_latent_texture.slang, now
        // replaced by a non-saturating leaky clamp. Re-test with the
        // penalty off first to measure the latent fix in isolation; only
        // re-enable if a luminance tail survives it.
        "coverage_penalty": {
            "weight": 0.0,
            "cap": 5.0,
            "samples": 8
        }
    },

    "model": {
        "seed": 0,
        "latents": {
            "type": "ntc_grid",
            "num_mip_levels": 1,
            "num_channels": 8,
            "normalize": false,
            "ntc_grid": {
                "grid_size_scale": 6,
                "num_features": 8,
                "num_pos_enc_waves": 3,
                "decoder_hidden_layers": [64, 48, 32],
                "decoder_activation": "HardGELU",
                "warmstart_iterations": 20000
            }
        },
        "encoder": {
            "hidden_layers": [64, 64, 64],
            "hidden_activations": "LeakyReLU"
        },
        "decoder": {
            "hidden_layers": [16, 16],
            "hidden_activations": "SmeLU",
            "output_activation": {
                "type": "ScaledSigmoid",
                "scale": 1e5
            },
            "half_diff_parameterization": "StableRusinkiewicz",
            "num_shading_frames": 2,
            "direction_inputs": "WhWdZiZo"
        },
        "sampler": {
            "num_specular_lobes": 1,
            "hidden_layers": [16, 16],
            "hidden_activations": "LeakyReLU"
        },
        "aux": {
            "targets": "ref_diffuse_specular_roughness_normal",
            "hidden_layers": [16, 16],
            "hidden_activations": "SmeLU"
        }
    },

    "data_generation": {
        "seed": 0,
        "batch_size_schedule": ["1k", "4k", "16k", "64k"],
        "num_batches_per_generation": 64,
        "share_data_between_instances": true,
        "directional_sampling_strategy": "Balanced_UniformRusinkiewicz_UniformWiImportanceWo",
        "balanced_directional_sampling_ratio": 0.95,
        "color_augmentation": {
            "enabled": true,
            "num_iterations": 100000,
            "start_ratio": 1.0,
            "end_ratio": 0.0
        },
        "lod": {
            "num_prefilter_samples": 64,
            "num_prefilter_samples_reference": 256
        }
    },

    "checkpoints": {
        "period": -1,
        "phases": ["BsdfEncoding", "BsdfDirectOptimization", "Sampler", "Aux"],
        "rendering": {
            "spp": 16,
            "max_depth": 10,
            "save_reference": true,
            "save_neural": true,
            "all_udims": false,
            "format": "exr"
        },
        "bsdf_plots": {
            "save": true,
            "num_uvs": 5,
            "num_samples": 1000,
            "axes": ["log"],
            "resolution": 450,
            "udim_id": -1
        },
        "model": {
            "save_images": true,
            "save_params": true
        },
        "loss_plots": {
            "save": true
        },
        "validation_losses": false
    }
}
