{
    // Project 3 (docs/project3-rtnam-ntc/PLAN.md), material #4: hard, sheen/retroreflective lobe.
    "reference_materials": [
        {
            "type": "mdl",
            "path": "vMaterials_2/Fabric/Velvet.mdl",
            "material": "Velvet"
        }
    ],

    "training": {
        "num_iterations": {
            "bsdf": 100000,
            "bsdf_finetuning": 0,
            "sampler": 50000,
            "aux": 50000
        },
        "deterministic": true,
        "optimizer": {
            "learning_rate": 0.001,
            "cosine_annealing_scale": 0.01,
            "gradient_scale": 128.0,
            "hyperparams": {
                "beta1": 0.9,
                "beta2": 0.999,
                "epsilon": 1e-07,
                "l2_regularization": 0.0,
                "ignore_invalid_gradients": true
            }
        },
        "instance_schedule": [64, 16, 4, 1],
        "loss_function": {
            "type": "L1WithPowerLog",
            "power": 3.0,
            "epsilon": 1e-4
        }
    },

    "model": {
        "seed": 0,
        "latents": {
            "num_mip_levels": 1,
            "num_channels": 8,
            "normalize": true
        },
        "encoder": {
            "hidden_layers": [64, 64, 64],
            "hidden_activations": "LeakyReLU"
        },
        "decoder": {
            "hidden_layers": [16, 16],
            "hidden_activations": "SmeLU",
            "output_activation": {
                "type": "ScaledSigmoid",
                "scale": 1e5
            },
            "half_diff_parameterization": "StableRusinkiewicz",
            "num_shading_frames": 2,
            "direction_inputs": "WhWdZiZo"
        },
        "sampler": {
            "num_specular_lobes": 1,
            "hidden_layers": [16, 16],
            "hidden_activations": "LeakyReLU"
        },
        "aux": {
            "targets": "ref_diffuse_specular_roughness_normal",
            "hidden_layers": [16, 16],
            "hidden_activations": "SmeLU"
        }
    },

    "data_generation": {
        "seed": 0,
        "batch_size_schedule": ["1k", "4k", "16k", "64k"],
        "num_batches_per_generation": 64,
        "share_data_between_instances": true,
        "directional_sampling_strategy": "Balanced_UniformRusinkiewicz_UniformWiImportanceWo",
        "balanced_directional_sampling_ratio": 0.95,
        "color_augmentation": {
            "enabled": true,
            "num_iterations": 100000,
            "start_ratio": 1.0,
            "end_ratio": 0.0
        },
        "lod": {
            "num_prefilter_samples": 64,
            "num_prefilter_samples_reference": 256
        }
    },

    "checkpoints": {
        "period": -1,
        "phases": ["BsdfEncoding", "BsdfDirectOptimization", "Sampler", "Aux"],
        "rendering": {
            "spp": 16,
            "max_depth": 10,
            "save_reference": true,
            "save_neural": true,
            "all_udims": false,
            "format": "exr"
        },
        "bsdf_plots": {
            "save": true,
            "num_uvs": 5,
            "num_samples": 1000,
            "axes": ["log"],
            "resolution": 450,
            "udim_id": -1
        },
        "model": {
            "save_images": true,
            "save_params": true
        },
        "loss_plots": {
            "save": true
        },
        "validation_losses": false
    }
}
